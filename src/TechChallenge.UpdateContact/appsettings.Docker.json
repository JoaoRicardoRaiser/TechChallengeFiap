{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Postgres": "Server=postgres;Port=5432;Database=tc-docker-create-contact;Username=postgres;Password=postgres;"
  },
  "RabbitMq": {
    "Infrastructure": {
      "HostName": "rabbitMq",
      "UserName": "guest",
      "Password": "guest",
      "Port": 5672
    },
    "Publishers": {
      "Default": {
        "RoutingKey": "*"
      },
      "ContactUpdated": {
        "Exchange": "contact",
        "RoutingKey": "updated"
      }
    },
    "Consumers": {
      "Default": {
        "RoutingKey": "*"
      },
      "ContactDeleted": {
        "Exchange": "contact",
        "Queue": "cc_contact_deleted",
        "RoutingKey": "deleted"
      },
      "ContactCreated": {
        "Exchange": "contact",
        "Queue": "cc_contact_created",
        "RoutingKey": "created"
      }
    },
    "Exchanges": {
      "Default": {
        "Type": "fanout",
        "Durable": true,
        "AutoDelete": false
      },
      "contact": {
        "Type": "topic"
      }
    },
    "Queues": {
      "Default": {
        "RoutingKey": "*",
        "Durable": false,
        "Exclusive": false,
        "AutoDelete": false
      },
       "cc_contact_updated": {},
       "cc_contact_created": {},
       "cc_contact_deleted": {}
    }
  }
}
