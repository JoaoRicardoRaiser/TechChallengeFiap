{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Postgres": "Server=postgres;Port=5432;Database=tc-docker-create-contact;Username=postgres;Password=postgres;"
  },
  "RabbitMq": {
    "Infrastructure": {
      "HostName": "rabbitMq",
      "UserName": "guest",
      "Password": "guest",
      "Port": 5672
    },
    "Publishers": {
      "Default": {
        "RoutingKey": "*"
      },
      "ContactCreated": {
        "Exchange": "contact",
        "RoutingKey": "created"
      }
    },
    "Exchanges": {
      "Default": {
        "Type": "fanout",
        "Durable": true,
        "AutoDelete": false
      },
      "contact": {}
    },
    "Queues": {
      "Default": {
        "RoutingKey": "*",
        "Durable": false,
        "Exclusive": false,
        "AutoDelete": false
      }
    }
  }
}
